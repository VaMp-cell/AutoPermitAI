# ── AutoPermit AI Environment Variables ──
# Copy this file to .env and fill in your values

# OpenAI API Key (Paid)
OPENAI_API_KEY=sk-your-key-here

# Google API Key (Free Tier - Gemini 1.5 Flash)
# Get your free key at: https://aistudio.google.com/
GOOGLE_API_KEY=AIzaSyD5wf6YDm1ydrMI1GrCMhErwf_mN3-7PfI

# YOLOv8 Model Path (relative to backend/ or absolute)
YOLO_MODEL_PATH=yolov8n.pt

# Upload & output directories
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs

# Supabase (optional — leave blank to use in-memory storage)
SUPABASE_URL=
SUPABASE_KEY=

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000

# OCR Path (Optional: set if tesseract is not in your PATH)
# Example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
